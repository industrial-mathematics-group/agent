# Copy to .env (Dockge: the "env" editor of the stack) and fill in. Never commit .env or imgagent.pem.

# --- The GitHub App (README, "Register the GitHub App") ---
# App ID, shown at the top of the App's settings page
IMGAGENT_APP_ID=
# The webhook secret you entered in the App's settings (e.g. from: openssl rand -hex 32)
IMGAGENT_WEBHOOK_SECRET=
# Only installations on these accounts are answered (comma-separated). The App is installable by any account,
# so this keeps strangers from spending your Claude credit.
IMGAGENT_ALLOWED_OWNERS=industrial-mathematics-group
# The private key is read from ./imgagent.pem (compose secret). Without that file, paste it here on one line
# with \n for the line breaks:
# IMGAGENT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# --- Claude ---
# A Claude Console API key, ideally in a workspace with a spend limit
ANTHROPIC_API_KEY=

# --- Optional ---
# The name people write after @ (the IMGAgent organisation you own)
# IMGAGENT_HANDLE=IMGAgent
# Also turn issues made with the form "Signoff: declare or attest files" into pull requests (replaces the
# Signoff-Request workflow in each repository). false: leave them to the workflow.
# IMGAGENT_SIGNOFF_FORM=true
# Jobs at the same time (each needs a clone of a repository and a few hundred MB at most)
# IMGAGENT_WORKERS=2
# Host port that compose.yaml publishes on 127.0.0.1
# IMGAGENT_PORT=8080
# Models
# DOCS_ASK_MODEL=claude-haiku-5-5
# DOCS_WRITER_MODEL=claude-opus-5-5
# DOCS_WRITER_EFFORT=medium
# SIGNOFF_MODEL=claude-sonnet-5-5
# SIGNOFF_MODEL_NAME=Claude Sonnet 5.5 (Anthropic)
# SIGNOFF_EFFORT=medium
# LOG_LEVEL=INFO
